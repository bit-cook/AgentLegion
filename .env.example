# Copy to .env and fill in to use a real OpenAI-compatible model.
# Without these, AgentLegion uses the deterministic MockLLM backend.

# --- real LLM backend (optional) -----------------------------------------
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure gateway, vLLM, Ollama, ...):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Force a backend explicitly: auto (default) | mock | openai
# AGENTLEGION_LLM_BACKEND=auto

# --- evolution knobs (all optional) --------------------------------------
# AGENTLEGION_MAX_AGENTS=50
# AGENTLEGION_GENERATIONS=20
# AGENTLEGION_MUTATION_RATE=0.25
# AGENTLEGION_PROBLEM=rastrigin
# AGENTLEGION_SEED=42
